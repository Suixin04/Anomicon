# 复制为 .env 后填入真实值，并确保私有文件权限安全
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=true

# GitHub 仓库配置
GITHUB_OWNER=Suixin04
GITHUB_REPO=Anomicon

# 在 GitHub App 设置页与安装地址中获取
GITHUB_APP_ID=你的AppID
GITHUB_INSTALLATION_ID=你的InstallationID

# 推荐将 GitHub 下载的 .pem 私钥放在服务器安全目录（chmod 600）
GITHUB_APP_PRIVATE_KEY_PATH=/etc/anomicon/github-app.pem

# 防刷限流参数（单 IP 默认每 10 分钟最多 3 单、每小时最多 5 单）
RATE_LIMIT_BURST_10M=3
RATE_LIMIT_PER_HOUR=5
